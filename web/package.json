{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-web.mjs",
    "test": "node --test src/*.test.js",
    "test:publisher-reconciliation": "node tests/publisher-reconciliation.browser.mjs",
    "test:publisher-repair": "node tests/publisher-repair.browser.mjs",
    "test:publisher-setup": "node tests/publisher-setup.browser.mjs",
    "test:publisher-deletion": "node tests/publisher-deletion.browser.mjs",
    "test:logs": "node --test src/logs.test.js && node tests/logs.browser.mjs",
    "test:mobile": "node tests/mobile-workspace.browser.mjs && node tests/project-row-update.browser.mjs && node tests/mobile-page-details.browser.mjs && node tests/container-cards.browser.mjs && npm run test:navigation",
    "test:navigation": "node tests/navigation.browser.mjs && node tests/update-review-navigation.browser.mjs",
    "test:icons": "node --test src/brandIcons.test.js",
    "test:updates": "node --test src/updateMetrics.test.js",
    "test:image-reference": "node --test src/imageReference.test.js",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
